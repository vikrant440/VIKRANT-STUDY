<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>UPSC Previous Year Questions</title>

<style>
*{box-sizing:border-box;margin:0;padding:0}

body{
  background:#080d18;
  color:#f4f7ff;
  font-family:Arial,sans-serif;
}

.app{
  max-width:760px;
  margin:auto;
  padding:18px;
  padding-bottom:40px;
}

.header{
  text-align:center;
  padding:25px 10px;
}

.header h1{
  font-size:27px;
  margin-bottom:10px;
}

.header h1 span{color:#55d8ff}

.header p{color:#91a4ba;font-size:13px}

.search{
  width:100%;
  padding:15px;
  background:#111a2a;
  border:1px solid #26374c;
  border-radius:25px;
  color:white;
  outline:none;
  margin:20px 0;
}

.stats{
  display:flex;
  justify-content:space-between;
  margin:12px 0 20px;
  color:#55d8ff;
  font-size:13px;
}

.year-card{
  background:#111a2a;
  border:1px solid #26374c;
  border-radius:17px;
  margin-bottom:12px;
  overflow:hidden;
}

.year-head{
  padding:18px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  cursor:pointer;
}

.year-head h3{font-size:17px}

.year-head small{
  color:#91a4ba;
  font-size:11px;
}

.year-icon{
  background:#123b50;
  color:#55d8ff;
  border-radius:12px;
  padding:12px;
  font-weight:bold;
}

.content{
  display:none;
  padding:0 15px 16px;
}

.year-card.open .content{display:block}

.group{
  background:#0b1421;
  border:1px solid #26374c;
  border-radius:13px;
  padding:13px;
  margin-top:10px;
}

.group h4{
  color:#55d8ff;
  margin-bottom:12px;
  font-size:14px;
}

.paper{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:10px;
  padding:12px 8px;
  border-top:1px solid #26374c;
  font-size:13px;
}

.paper a{
  text-decoration:none;
  color:#55d8ff;
  font-size:12px;
  white-space:nowrap;
}

.paper a:hover{color:white}

.btn{
  display:block;
  text-align:center;
  padding:13px;
  margin-top:12px;
  border-radius:12px;
  background:#087e91;
  color:white;
  text-decoration:none;
  font-size:13px;
}

.empty{
  display:none;
  text-align:center;
  padding:35px;
  color:#91a4ba;
}

.footer{
  text-align:center;
  color:#71849a;
  padding:25px 5px;
  font-size:12px;
}
</style>
</head>

<body>
<div class="app">

<div class="header">
  <div style="color:#55d8ff;font-size:12px;letter-spacing:2px">
    VIKRANT STUDY
  </div>
  <h1>UPSC <span>Previous Year</span> Questions</h1>
  <p>Year-wise Civil Services PYQ Collection</p>
</div>

<input class="search" id="search"
placeholder="Search Year... e.g. 2020">

<div class="stats">
  <span>UPSC PYQ FOLDERS</span>
  <span id="total">16 Years</span>
</div>

<div id="years"></div>

<div class="empty" id="empty">No Year Found!</div>

<div class="footer">
  © VIKRANT STUDY · UPSC PYQ Collection
</div>

</div>

<script>

// UPSC YEARS
const years = [];

for(let y=2025;y>=2010;y--){
  years.push(y);
}

const papers = [
  {
    name:"PRELIMS",
    items:[
      "General Studies Paper 1",
      "CSAT Paper 2"
    ]
  },
  {
    name:"MAINS - GENERAL STUDIES",
    items:[
      "Essay Paper",
      "General Studies Paper 1",
      "General Studies Paper 2",
      "General Studies Paper 3",
      "General Studies Paper 4"
    ]
  },
  {
    name:"MAINS - OPTIONAL",
    items:[
      "Optional Paper 1",
      "Optional Paper 2"
    ]
  }
];

// Official UPSC source
const officialURL =
"https://www.upsc.gov.in/examinations/previous-question-papers";

const container = document.getElementById("years");

function renderYears(list){

  container.innerHTML="";

  list.forEach(year=>{

    const card=document.createElement("div");
    card.className="year-card";

    let groups="";

    papers.forEach(group=>{

      let rows="";

      group.items.forEach(item=>{

        rows+=`
          <div class="paper">
            <span>${item}</span>
            <a href="${officialURL}" target="_blank"
            rel="noopener">View PDF ↗</a>
          </div>
        `;
      });

      groups+=`
        <div class="group">
          <h4>${group.name}</h4>
          ${rows}
        </div>
      `;
    });

    card.innerHTML=`
      <div class="year-head">
        <div>
          <h3>📁 UPSC ${year}</h3>
          <small>Prelims + Mains Question Papers</small>
        </div>
        <div class="year-icon">${year}</div>
      </div>

      <div class="content">
        ${groups}
        <a class="btn" href="${officialURL}"
        target="_blank" rel="noopener">
          Open Official UPSC Question Papers
        </a>
      </div>
    `;

    card.querySelector(".year-head").onclick=()=>{
      card.classList.toggle("open");
    };

    container.appendChild(card);
  });

  document.getElementById("total").innerText=
  list.length+" Years";

  document.getElementById("empty").style.display=
  list.length ? "none" : "block";
}

// SEARCH YEAR
document.getElementById("search").addEventListener("input",e=>{

  const value=e.target.value.trim();

  const filtered=years.filter(year=>
    year.toString().includes(value)
  );

  renderYears(filtered);
});

renderYears(years);

</script>
</body>
</html>
